{
  "name": "mc-agent-mvp",
  "version": "0.3.0",
  "description": "Minecraft Autonomous Curiosity Agent - MVP (Mineflayer + LLM planner + spectator observation)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "postinstall": "node scripts/patch-deps.mjs",
    "start": "tsx src/main.ts",
    "start:proxy": "node --env-file=.env --use-env-proxy --import tsx src/main.ts",
    "start:local": "node --env-file=.env.local scripts/supervise.mjs",
    "start:live": "node --env-file=.env.live scripts/supervise.mjs",
    "start:local:proxy": "node --env-file=.env.local scripts/supervise.mjs --proxy",
    "start:live:proxy": "node --env-file=.env.live scripts/supervise.mjs --proxy",
    "supervise": "node scripts/supervise.mjs",
    "supervise:proxy": "node scripts/supervise.mjs --proxy",
    "supervise:local": "node --env-file=.env.local scripts/supervise.mjs",
    "supervise:live": "node --env-file=.env.live scripts/supervise.mjs",
    "supervise:local:proxy": "node --env-file=.env.local scripts/supervise.mjs --proxy",
    "supervise:live:proxy": "node --env-file=.env.live scripts/supervise.mjs --proxy",
    "supervise:curio:live": "node scripts/supervise.mjs --curio=live",
    "supervise:curio:local": "node scripts/supervise.mjs --curio=local",
    "supervise:curio:test": "node scripts/supervise.mjs --curio=test",
    "test:config": "node --import tsx scripts/test-env.ts --curio=test config",
    "test:init": "node --import tsx scripts/test-env.ts --curio=test init",
    "test:start": "node scripts/supervise.mjs --curio=test",
    "dev": "tsx watch src/main.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "check:rcon": "tsx scripts/check-rcon.ts",
    "check:rcon:local": "node --env-file=.env.local --import tsx scripts/check-rcon.ts",
    "check:rcon:live": "node --env-file=.env.live --import tsx scripts/check-rcon.ts",
    "memory:clear": "tsx scripts/clear-memory.ts",
    "memory:reset": "tsx scripts/clear-memory.ts --full",
    "memory:serve": "docker compose -f compose.memory.yaml up -d",
    "memory:serve:local": "docker compose --env-file .env --env-file .env.local -f compose.memory.yaml up -d",
    "check:memory": "tsx scripts/check-memory.ts",
    "check:memory:local": "node --env-file=.env.local --import tsx scripts/check-memory.ts",
    "check:memory:live": "node --env-file=.env.live --import tsx scripts/check-memory.ts",
    "fixtures:spatial-pre-real": "tsx scripts/spatial-pre-real-fixtures.ts",
    "test": "tsx --test tests/*.test.ts",
    "world:seed": "tsx scripts/world-seed.ts",
    "agents:list": "tsx scripts/agents.ts list",
    "agents:save": "tsx scripts/agents.ts save",
    "agents:load": "tsx scripts/agents.ts load",
    "save": "tsx scripts/agents.ts save",
    "load": "tsx scripts/agents.ts load",
    "save:local": "node --env-file=.env.local --import tsx scripts/agents.ts save",
    "load:local": "node --env-file=.env.local --import tsx scripts/agents.ts load",
    "agents:local": "node --env-file=.env.local --import tsx scripts/agents.ts",
    "memory:clear:local": "node --env-file=.env.local --import tsx scripts/clear-memory.ts",
    "memory:reset:local": "node --env-file=.env.local --import tsx scripts/clear-memory.ts --full",
    "world:seed:local": "node --env-file=.env.local --import tsx scripts/world-seed.ts",
    "agents:new": "tsx scripts/agents.ts new",
    "agents:switch": "tsx scripts/agents.ts switch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "1.1.0",
    "better-sqlite3": "^12.11.1",
    "curio-minecraft-3d-memory": "file:vendor/curio-minecraft-3d-memory-0.10.1-workflow.1.tgz",
    "curio-observer": "file:../CurioObserver",
    "gridstack": "12.3.3",
    "minecraft-data": "^3.60.0",
    "mineflayer": "^4.20.0",
    "mineflayer-pathfinder": "^2.4.5",
    "typescript": "^5.6.0",
    "vec3": "^0.1.10"
  },
  "optionalDependencies": {
    "prismarine-viewer": "^1.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
