# ===== 运行环境 =====
# 三层配置：公共项放 .env，本地/直播差异放 .env.local / .env.live，运行时合并（模式文件覆盖公共）。
# local 允许本地 save/load 和世界管理；live 只连接直播服务，不执行本地维护
CURIO_MODE=local
# 可选：数据 + env 文件放在项目外的独立目录（如 /path/to/curio）时，这里填它的根路径。
# npm run supervise:curio:live / :local 会用 $CURIO_ROOT/.env.live（或 .env.local），并自动合并同目录下的 .env。
CURIO_ROOT=
# 选择模式：node --env-file=.env --env-file=.env.local（或 .env.live）；也支持进程变量 ENV_FILE 指定模式文件
# 本文件是完整参考模板，列出所有参数与默认值（公共项和模式差异项都写在这里）。

# ===== Minecraft 服务器 =====
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.20.1
# Bot 的游戏名（离线模式）
BOT_USERNAME=Curio

# ===== 观察（RCON 自动旁观）=====
# 你自己在客户端里的玩家名；留空则不自动旁观
OBSERVER_PLAYER=
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change-me-to-a-long-random-string
# 启动时通过 RCON 设置游戏规则（立即重生、是否死亡不掉落）
SETUP_GAMERULES=true
# 死亡不掉落：false = 死了会掉东西，需要 Agent 自己回去捡（默认）
KEEP_INVENTORY=false
# 允许在游戏聊天里用 !pause / !resume / !replan / !goal <内容> 控制 Agent 的玩家，逗号分隔（默认包含 OBSERVER_PLAYER）
ADMIN_PLAYERS=

# ===== 新世界与出生点（种子筛选）=====
# 开新世界时（npm run agents:new、memory:reset、world:seed）按出生点群系挑种子：每试一个种子要启动一次服务端（约 1–2 分钟）
# 出生难度：easy（平原、森林、桦木林、繁花森林、草甸、樱花林）| normal（针叶林、热带草原、黑森林、沼泽、河边、海滩、丛林）
#          | hard（沙漠、恶地、雪原雪林、竹林、红树林、风袭丘陵、雪坡、石岸）| extreme（冰刺、山峰、蘑菇岛、海洋、洞穴）| any（不筛）
# 可以逗号写几档，如 easy,normal；完整的群系分级：npm run world:seed -- --tiers
WORLD_SPAWN_DIFFICULTY=easy
# 只接受这些出生群系（逗号分隔，如 plains,cherry_grove；写了就不看上面的难度）
WORLD_SPAWN_BIOMES=
# 固定种子（写了就直接用，不筛）
WORLD_SEED=
# 强制出生点附近有村庄（true/false）：没有村庄的种子直接淘汰，难度可以退而求其次、村庄不行
WORLD_REQUIRE_VILLAGE=false
# 村庄要在出生点多少格内（水平距离，32–1600）
WORLD_VILLAGE_RADIUS=512
# 最多试几个种子；都不符合就用最接近的那个
WORLD_SEED_TRIES=8
# 试种子时怎么启动服务端：服务器目录（默认 ./world）、jar（默认自动找）、java 命令和参数
SERVER_DIR=
SERVER_JAR=
SERVER_JAVA=java
SERVER_JAVA_ARGS=-Xmx2G

# ===== LLM =====
# mock：不需要 API Key，用内置规则模拟 LLM（用来先验证链路）
# 其他任何值（openai / deepseek / ollama …）：走 OpenAI 兼容接口，只是个显示名
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
# 是否发送 response_format=json_object（部分本地模型不支持时改为 false）
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=120000
# 单次回复的 token 上限；推理型模型的思考过程也会计入，太小会导致输出为空或被截断
LLM_MAX_TOKENS=16384
# 流式请求（控制台实时显示模型输出；服务端不支持会自动回退为普通请求）
LLM_STREAM=true
# 小决策是否先长篇思考：auto（DeepSeek 时关闭，决策更快、信息不易过时）| on | off
LLM_LIGHT_THINKING=auto
# 认真想时的推理力度：auto（DeepSeek 用 low，想得短）| low | high | max | off（不发这个参数）；建筑设计固定 high
LLM_REASONING_EFFORT=auto
# 后台写代码的模型（从死亡/卡住里造技能、改进代码技能）：不赶时间，建议用更强的模型；不设就用上面的 LLM_MODEL
# CODER_LLM_MODEL=deepseek-reasoner
# CODER_LLM_BASE_URL=          # 不填沿用 LLM_BASE_URL
# CODER_LLM_API_KEY=           # 不填沿用 LLM_API_KEY
CODER_LLM_REASONING_EFFORT=low
# 三类写代码调用可分别覆盖推理力度（不写就用上面的）：总结新技能 / 改进 / 整理技能库
# CODER_LLM_REASONING_EFFORT_FORGE=low
# CODER_LLM_REASONING_EFFORT_IMPROVE=low
# CODER_LLM_REASONING_EFFORT_CURATE=low
CODER_LLM_MAX_CALLS_PER_HOUR=1000
# 后台写代码单次回复的 token 上限、超时（毫秒）
CODER_LLM_MAX_TOKENS=32768
CODER_LLM_TIMEOUT_MS=300000
# 每小时最多调用次数；真实模型超出后保留意图等待，mock 兼容模式可用规则目标
LLM_MAX_CALLS_PER_HOUR=90
# 延迟注入（毫秒）：人为让每次 LLM 调用变慢，用来验证动作连贯性
LLM_FAKE_DELAY_MS=0
# 真实花费（直播 HUD / 控制台「直播」页）：内置 DeepSeek 价格表（deepseek-flash、deepseek-v4-pro，含工作日高峰价×2）
# 别的模型在这里写价格：每百万 token「缓存命中,未命中,输出[,币种]」，写了就不再套高峰规则
# LLM_PRICE=0.02,1,4
# CODER_LLM_PRICE=
# 记忆服务（Hindsight）的模型价格，不写就按它上报的模型名查表
# MEMORY_LLM_PRICE=
# 按闲时价算的法定节假日（北京时间日期，逗号分隔）
# LLM_PRICE_HOLIDAYS=2026-10-01,2026-10-02

# 可选 HTTP(S) 代理：使用 npm run start:proxy（需要 Node.js 24.5+ 或 22.21+）
# 代理地址填写代理软件的 HTTP/混合端口；HTTPS 目标也可使用 http:// 代理。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1

# ===== 情境记忆（详见 docs/memory-hindsight.md）=====
# local 不依赖额外服务；hindsight 启用长期经历整理与按需召回
MEMORY_PROVIDER=local
# 同一服务器换存档时必须修改此值；留空请删除本行以使用 MC_HOST:MC_PORT
MEMORY_WORLD_ID=127.0.0.1:25565
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
MEMORY_TIMEOUT_MS=1500
MEMORY_RETAIN_TIMEOUT_MS=60000
MEMORY_CONTEXT_MAX_BYTES=6000
# Hindsight 默认复用上面的 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY
# 仅需要单独的服务模型时取消注释；空值仍会回退到 LLM_*。
# 项目 LLM_PROVIDER 是兼容接口的显示名，服务 provider 默认使用 openai。
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=
# HINDSIGHT_API_LLM_MODEL=
# 给记忆服务单独一个 key，在服务商后台就能把它的花费和 Curio 分开看；留空回退到 LLM_API_KEY
HINDSIGHT_API_LLM_API_KEY=
# 记忆服务的推理：DeepSeek 默认开思考且力度 high，抽取事实用不着，这里关掉（JSON，原样并进请求体）
# 换成别家模型时清空这一行（会回到 null），需要的话改用下面的推理力度
HINDSIGHT_API_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 推理力度（none/low/medium/high，直接透传；DeepSeek 用上面的关思考即可，不用填）
# HINDSIGHT_API_LLM_REASONING_EFFORT=low

# ===== Agent 人设（会放进系统提示词）=====
AGENT_PERSONA=你叫 Muses，一个好奇、谨慎、喜欢记录新发现的 Minecraft 探险家。你喜欢先保证安全，再去看没见过的东西；既想把住处经营得温馨妥帖，又总向往着去更广阔的天地闯一闯。

# ===== 心智层（像真人一样思考、行动、学习）=====
# 性格关键词（逗号分隔），每次思考都会带上，也保存在 data/mind.json
AGENT_TRAITS=好奇,谨慎,喜欢记录新发现,有点恋家,喜欢田园生活,向往远方
# 身体习惯：饿了顺手吃、卡住自己挣脱；自动照明由 Agent 的 torch_every 习惯单独选择
MIND_BODY_HABITS=false
# 一段活做了多少秒没抬头，就“瞥一眼”周围；只瞥一眼多少秒后要认真想想全局
MIND_CHECK_IN_SEC=100
MIND_DELIBERATE_EVERY_SEC=360
# 代码技能（模型自己写的 JavaScript）老失败时在后台请模型改进：两次改进至少隔多少分钟（0 = 不限，同一时间只改一份）
SKILL_IMPROVE_GAP_MIN=0
# 同一份代码技能最多改几轮，改了这么多版还不可靠就收起（0 = 不限）
# SKILL_IMPROVE_MAX_ROUNDS=5
# 后台改进代码技能每小时最多几次
# SKILL_IMPROVE_MAX_PER_HOUR=12
# 后台写技能每小时最多请模型几次（死亡不算）；同一件事多少分钟内不再请第二次
# SKILL_FORGE_MAX_PER_HOUR=24
# SKILL_FORGE_REPEAT_MIN=20
# 攒批：第一件事进队后等多少秒，把这段时间的事一次请模型看完（死亡不等）；0 = 来一件看一件
# SKILL_FORGE_BATCH_SEC=180

# ===== AI 视觉（射线模拟，不透视）=====
# 能看多远（格）。auto 跟随服务器渲染距离；普通视觉与显式配置均最多 64 格
VISION_RANGE=auto
# 水平/垂直视野角度
VISION_FOV=100
VISION_VFOV=60
# 射线分辨率（列×行）：越大越精细，越耗 CPU
VISION_COLS=40
VISION_ROWS=24
# 地平线高分辨率带（只用于发现远处的树/矿/结构，不画进画面）
VISION_BAND_COLS=160
VISION_BAND_ROWS=8
# 听觉半径（格）：看不见但这么近的敌对生物会被“听见”
VISION_HEAR=10

# ===== Curio Observer 模组（第一人称 HUD / 合成界面）=====
# 在控制台同一端口提供 /api/observer/stream，供观察者客户端里的 Curio Observer 模组连接
OBSERVER_FEED=true
# 界面等待（毫秒）：默认只在打开和关闭窗口时短暂停留，点击与批量操作不逐次放慢。
# 非零值会延迟实际游戏操作；各项设为 0 可关闭对应等待。
UI_PACING_MS=0
UI_OPEN_HOLD_MS=250
UI_CLOSE_HOLD_MS=450
# 模组 HUD 的布局、开关、镜头和亮度在控制台「直播」页调，存在这个文件（不跟着角色存档走）
# OBSERVER_HUD_CONFIG=./live/observer-hud.local.json
# 收到的每条弹幕按天存档（含被拦下的），控制台「直播」页可以查、筛出提问
# DANMAKU_ARCHIVE_DIR=./archives/local/danmaku

# ===== 观测 =====
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
# >0 时启用 prismarine-viewer 浏览器 3D 调试视图（需要可选依赖安装成功）
VIEWER_PORT=0
DATA_DIR=./data/local
AGENTS_DIR=./agents/local
# 堆内存用到这么多 MB 时，在 DATA_DIR/logs 写一份堆快照（每次启动最多一次，约和堆一样大），查内存是谁占的；0 = 不写
HEAP_SNAPSHOT_MB=1024
# 自主意图、上下文预算及可选视觉输入
LLM_MAX_PROMPT_TOKENS=128000
LLM_CONTEXT_WINDOW_TOKENS=1000000
LLM_COMPACT_AT_RATIO=0.75
LLM_MAX_RECALL_ROUNDS=2
LLM_VISION_INPUT=false
# 仅独立试验世界可为新方法提供晋升证据；世界 ID 来自 MEMORY_WORLD_ID
LEARNING_TEST_WORLD_IDS=
# 在服务器聊天展示 AI 的简短想法，便于 ServerReplay 录制
CHAT_ACTIONS=true
CHAT_ACTION_INTERVAL_MS=1800

# ---- B 站直播间（可选）：弹幕作为“观众的声音”给 agent 参考，不会当作指令 ----
BILIBILI_ENABLED=false
# web：填直播间号即可（免登录能收到弹幕，但观众昵称会被打码）；open：B 站直播开放平台互动玩法（官方接口，需要应用和主播身份码）
BILIBILI_MODE=web
BILIBILI_ROOM_ID=
# 可选（web 模式）：登录 cookie，例如 SESSDATA=…; buvid3=…；只用于连接，不写进日志
BILIBILI_COOKIE=
BILIBILI_UID=
# open 模式：开放平台应用 ID / access key / secret，以及主播在直播姬里看到的身份码
BILIBILI_OPEN_APP_ID=
BILIBILI_OPEN_ACCESS_KEY=
BILIBILI_OPEN_ACCESS_SECRET=
BILIBILI_OPEN_CODE=
# 观众弹幕进提示词的条数、只看最近多少秒、每位观众两条间隔、额外屏蔽词（逗号分隔）
AUDIENCE_MAX_IN_PROMPT=6
AUDIENCE_WINDOW_SEC=180
AUDIENCE_PER_USER_GAP_SEC=8
AUDIENCE_BLOCK_WORDS=
# 回复显示观众昵称：0 = 匿名（默认），1 = 显示清洗后的最多 12 字昵称；游戏 LLM 始终匿名。修改后重启 Curio 生效。
LIVE_SHOW_NAMES=0

# ---- 直播 Live2D 桌宠 + 侧边聊天（live/curio-pet-bridge，可选，不属于 Curio 本体）----
# 桌宠页面端口（OBS 浏览器源打开 http://127.0.0.1:端口/）和气泡署名（留空不显示署名）
PET_PORT=3100
PET_NAME=
# 侧边聊天：另一个小 LLM 只负责回观众弹幕、显示在 Live2D 气泡里，不影响游戏；0 = 关闭
LIVE_CHAT=1
# 不填就复用上面的 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL
# LIVE_CHAT_MODEL=
# LIVE_CHAT_BASE_URL=
# LIVE_CHAT_API_KEY=
# 两次回复至少隔多少毫秒、每小时最多回复多少条
LIVE_CHAT_GAP_MS=5000
LIVE_CHAT_MAX_PER_HOUR=300

# ---- 直播语音说话人（CurioLive2d 仓库，可选，不属于 Curio 本体）----
# 用它说话时把上面的 LIVE_CHAT 设为 0，避免两边同时回弹幕。以下参数改了不用重启，下一句就生效。
# 服务端口（OBS 浏览器源 http://127.0.0.1:端口/ ，控制页 /control；改端口要重启说话服务）
SPEECH_PORT=3200
# 舞台页连上后自动开播（先说开场白）：1 = 是，0 = 在控制页手动开播
SPEECH_AUTOSTART=1
# 开场白 / 结束语（会预先合成缓存）
SPEECH_OPENING=哈喽哈喽，开播啦！今天也一起看看这个世界里会发生什么吧～
SPEECH_CLOSING=今天就先到这里啦，谢谢大家陪我玩，下次见哦～
# 两句之间的最短停顿 / 弹幕和解说互相切换时的停顿（秒）
SPEECH_GAP_SEC=1.0
SPEECH_SWITCH_GAP_SEC=1.75
# 两句解说之间的最短间隔 / 高优先级话题可缩短到的间隔 / 安静多久后才说低优先级话题（秒）
SPEECH_NARRATION_MIN_GAP_SEC=45
SPEECH_NARRATION_URGENT_GAP_SEC=15
SPEECH_NARRATION_IDLE_AFTER_SEC=90
# 同一话题说过后多少分钟内不再说
SPEECH_TOPIC_REPEAT_BLOCK_MIN=10
# 弹幕回复 / 解说一句的字数上限
SPEECH_REPLY_MAX_CHARS=40
SPEECH_NARRATION_MAX_CHARS=45
# 弹幕等多久作废 / 同一观众两次被回复的最短间隔（秒）
SPEECH_DANMAKU_EXPIRE_SEC=90
SPEECH_VIEWER_REPLY_COOLDOWN_SEC=120
# 连续回复几句弹幕后插一句解说
SPEECH_MAX_REPLIES_BEFORE_NARRATION=3
# 每小时字数上限，超过后只说高优先级话题（也给 TTS 费用封顶）
SPEECH_CHARS_PER_HOUR_CAP=5000
# 只有免费礼物（小心心等）时两次感谢至少隔多少秒；同一位观众的免费礼物多久只谢一次（秒）
SPEECH_FREE_GIFT_THANKS_GAP_SEC=60
SPEECH_FREE_GIFT_VIEWER_COOLDOWN_SEC=300
# 控制页模拟弹幕和礼物（会真的在直播里回复、感谢），平时保持 0
SPEECH_TEST_API=0
# 礼物感谢排在所有弹幕前面、不受每小时字数上限限制。普通礼物等连击送完再谢，最多等多少秒
SPEECH_GIFT_MERGE_SEC=10
# 礼物价值档位（元，一次连击合计）：达到「中等」感谢更用心；达到「大礼物」1.5 秒内就谢、立刻换开心表情（舰长等也算大礼物）
SPEECH_GIFT_MID_YUAN=5
SPEECH_GIFT_BIG_YUAN=30
# 送礼 / 被感谢后多少分钟内，这位观众的弹幕优先回、不受点名冷却限制（让感谢里抛出的问题能接上话）
SPEECH_GIFTER_ENGAGE_MIN=10
# 感谢一句的字数上限（不含点名）
SPEECH_THANKS_MAX_CHARS=40
# 两次手势的最短间隔 / 排队手势多久没播就丢弃 / 句末表情保持多久（秒）
SPEECH_GESTURE_MIN_GAP_SEC=8
SPEECH_GESTURE_STALE_SEC=3
SPEECH_EXPRESSION_HOLD_SEC=2
# 句子生成 LLM：不填就复用上面的 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL；超过多少秒没返回就放弃这一句
# SPEECH_LLM_MODEL=
# SPEECH_LLM_BASE_URL=
# SPEECH_LLM_API_KEY=
SPEECH_LLM_TIMEOUT_SEC=8
# 云端 TTS：none（默认，关闭语音，只显示字幕）/ minimax（MiniMax 官方接口）/ cosyvoice（阿里云百炼）
# 打开语音：改成 minimax 并填 MINIMAX_API_KEY，下一句就生效
TTS_PROVIDER=none
# 语速倍率 / 首包超时（秒）
TTS_SPEED=1.05
TTS_TIMEOUT_SEC=6
# MiniMax 官方：API Key、模型、音色（默认俏皮萌妹；也可试 female-shaonv、Chinese (Mandarin)_Crisp_Girl、tianxin_xiaoling）、接口地址（海外账号用 https://api.minimax.io/v1/t2a_v2）、语种增强
MINIMAX_API_KEY=
TTS_MINIMAX_MODEL=speech-2.8-turbo
TTS_MINIMAX_VOICE=qiaopi_mengmei
TTS_MINIMAX_URL=https://api.minimax.cn/v1/t2a_v2
TTS_MINIMAX_LANGUAGE=Chinese
# 阿里云百炼 CosyVoice（TTS_PROVIDER=cosyvoice 时用）：API Key、模型、音色
DASHSCOPE_API_KEY=
TTS_COSYVOICE_MODEL=cosyvoice-v3-flash
TTS_COSYVOICE_VOICE=longanyang
