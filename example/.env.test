# 测试环境覆盖：只写与本地/直播不同的部分；公共项（模型、密钥、视觉/心智等）见 .env
# 运行时合并到 .env 之上，本文件优先。用 --curio=test 定位 $CURIO_ROOT/.env.test（与 supervise:curio:live / :local 一致）。
# test 是集成验收用的独立宿主环境：独立连接、世界副本与运行状态，不碰 local/live 的数据。
# 注意：使用 CURIO_ROOT 部署时，下面这些路径要写成 $CURIO_ROOT 下的绝对路径（参考实际的 .env.local / .env.live）。

CURIO_MODE=test

# ===== Minecraft / RCON（本机测试服务器，独立端口，不能与 local/live 相同）=====
MC_HOST=127.0.0.1
MC_PORT=25566
RCON_HOST=127.0.0.1
RCON_PORT=25576
RCON_PASSWORD=change-me-to-the-test-server-password
NO_PROXY=localhost,127.0.0.1,::1

# ===== 数据目录与归档（必须与 local/live 分开，不能相同或相互包含）=====
# 本任务的测试服务端与持久化数据统一放在 /path/to/curio/test-setver 下，见 docs/test-environment.md。
DATA_DIR=./data/test
AGENTS_DIR=./agents/test
# 测试世界副本目录：世界与 server.properties 由操作者显式放置到 test 专属目录，不指向 local 世界。
SERVER_DIR=./world-test
LLM_ARCHIVE_DIR=./archives/test/llm-calls
DANMAKU_ARCHIVE_DIR=./archives/test/danmaku
OBSERVER_HUD_CONFIG=./live/observer-hud.test.json

# ===== 情境记忆 =====
# 首轮不迁移旧记忆：用 local 提供程序，经历记在 DATA_DIR 里，不连 Hindsight、不共享 bank。
MEMORY_PROVIDER=local
# 必须显式指定独立世界身份；同一测试世界重启要保持不变，换存档才改。不能沿用公共 .env 的默认值。
MEMORY_WORLD_ID=curio-test-01

# ===== 观测 / 直播 =====
DASHBOARD_PORT=3002
BILIBILI_ENABLED=false

# ===== LLM（集成验收先用 mock，不产生真实调用）=====
LLM_PROVIDER=mock
