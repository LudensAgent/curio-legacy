# 测试环境覆盖：只写与本地不同的部分；公共项（模型、密钥、视觉/心智等）见 .env
# 运行时合并到 .env 之上，本文件优先。用 node --env-file=.env --env-file=.env.test 加载，
# 或用 --curio=test 定位 $CURIO_ROOT/.env.test（与 supervise:curio:local 一致）。
# test 是集成验收用的独立宿主环境：独立连接、世界副本与运行状态，不碰 local 的数据。
# 注意：相对路径一律以本配置文件所在目录为锚点解析（仓库内部署 = 仓库根，CURIO_ROOT 部署 = $CURIO_ROOT），
# 与 test:config / test:init / test:start 实际读写一致。
# 使用 CURIO_ROOT 部署时，下面这些路径建议写成 $CURIO_ROOT 下的绝对路径。

CURIO_MODE=test

# ===== Minecraft / RCON（本机测试服务器，独立端口，不能与 local 相同）=====
MC_HOST=127.0.0.1
MC_PORT=25566
RCON_HOST=127.0.0.1
RCON_PORT=25576
RCON_PASSWORD=change-me-to-the-test-server-password
NO_PROXY=localhost,127.0.0.1,::1

# ===== 数据目录与归档（必须与 local 分开，不能相同或相互包含；全部落在 TEST_ROOT_DIR 内）=====
# 测试根目录（必填）：隔离校验要求所有可写目录（含 HUD 配置）都落在它之内。
TEST_ROOT_DIR=./test
DATA_DIR=./test/data
AGENTS_DIR=./test/agents
# 测试世界副本目录：世界种子必须显式复制到这里（npm run test:init -- --seed <源服务器目录>），不能直接指向 local 世界。
# 种子源应是 TEST_ROOT_DIR 内、与 SERVER_DIR 互不包含的兄弟目录（例如 ./test/seed-world），不能是 SERVER_DIR 自身或其子目录。
SERVER_DIR=./test/world
LLM_ARCHIVE_DIR=./test/archives/llm-calls
OBSERVER_HUD_CONFIG=./test/observer-hud.json

# ===== 情境记忆 =====
# 首轮不迁移旧记忆：用 local 提供程序，经历记在 DATA_DIR 里，不连 Hindsight、不共享 bank。
MEMORY_PROVIDER=local
# 必须显式指定独立世界身份；同一测试世界重启要保持不变，换存档才改。不能沿用公共 .env 的默认值。
MEMORY_WORLD_ID=curio-test-01

# ===== 空间记忆库（curio-minecraft-3d-memory）=====
# SQLite 数据库文件；不写则默认 DATA_DIR/spatial/spatial.sqlite，随数据目录一起隔离。
# 库只接受显式参数，不识别 local/test。
# SPATIAL_DB_PATH=./test/data/spatial/spatial.sqlite

# ===== 观测 =====
DASHBOARD_PORT=3002

# ===== LLM（集成验收先用 mock，不产生真实调用）=====
LLM_PROVIDER=mock
