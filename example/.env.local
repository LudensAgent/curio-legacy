# 本地运行覆盖：只写与公共 .env 不同的部分；公共项（模型、密钥、端口、视觉/心智等）见 example/.env
# 运行时合并到 .env 之上，本文件优先。用 node --env-file=.env --env-file=.env.local 加载。
CURIO_MODE=local

# ===== Minecraft / RCON =====
MC_HOST=127.0.0.1
RCON_HOST=127.0.0.1
RCON_PASSWORD=change-me-to-the-local-server-password
NO_PROXY=localhost,127.0.0.1,::1

# ===== 数据目录与归档 =====
DATA_DIR=./data/local
AGENTS_DIR=./agents/local
LLM_ARCHIVE_DIR=./archives/local/llm-calls

# ===== 情境记忆 =====
HINDSIGHT_URL=http://127.0.0.1:8888
MEMORY_TIMEOUT_MS=1500
# 建议使用独立世界身份；留空则沿用公共 .env 的 MEMORY_WORLD_ID
# MEMORY_WORLD_ID=curio-local-01

# ===== 观测 =====
DASHBOARD_PORT=3001
OBSERVER_HUD_CONFIG=./observer-hud.local.json
