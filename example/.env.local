# 本地测试覆盖：只写与直播不同的部分；公共项（模型、密钥、端口、视觉/心智等）见 .env / .env.example
# 运行时合并到 .env 之上，本文件优先。用 node --env-file=.env --env-file=.env.local 加载。
CURIO_MODE=local

# ===== Minecraft / RCON（Windows 本机）=====
MC_HOST=127.0.0.1
RCON_HOST=127.0.0.1
RCON_PASSWORD=change-me-to-the-local-server-password
# 本机地址不需要代理例外，也可只写 localhost,127.0.0.1,::1
NO_PROXY=localhost,127.0.0.1,::1

# ===== Agent 人设（覆盖公共 .env 里的默认人设）=====
AGENT_PERSONA=你叫 Muses，一个好奇、谨慎、喜欢记录新发现的 Minecraft 探险家。你喜欢先保证安全，再去看没见过的东西。

# ===== 数据目录与归档 =====
DATA_DIR=./data/local
AGENTS_DIR=./agents/local
LLM_ARCHIVE_DIR=./archives/local/llm-calls
DANMAKU_ARCHIVE_DIR=./archives/local/danmaku

# ===== 情境记忆 =====
HINDSIGHT_URL=http://127.0.0.1:8888
MEMORY_TIMEOUT_MS=1500
# 本地测试建议用独立世界身份，避免和直播记忆混淆；留空则沿用公共 .env 的 MEMORY_WORLD_ID
# MEMORY_WORLD_ID=curio-local-test-01

# ===== 观测 / 直播 =====
DASHBOARD_PORT=3001
BILIBILI_ENABLED=false
OBSERVER_HUD_CONFIG=./live/observer-hud.local.json
